generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  SUPER_ADMIN
  QUEUE_MASTER
}

enum QueueMasterStatus {
  ACTIVE
  DISABLED
}

enum Gender {
  MALE
  FEMALE
}

enum SkillLevel {
  NEWBIE
  BEGINNER
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum PlayerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum QueuePlayerStatus {
  INACTIVE
  WAITING
  QUEUED
  PLAYING
  RESTING
  CHECKED_OUT
}

enum CourtStatus {
  AVAILABLE
  OCCUPIED
  PAUSED
  CLOSED
}

enum MatchStatus {
  QUEUED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchSource {
  MANUAL
  AUTOMATIC
  MANUAL_ADJUSTED
}

enum MatchmakingMode {
  OPEN
  SAME_SKILL
  BALANCED
  SAME_GENDER
  MIXED_DOUBLES
}

enum TeamSide {
  A
  B
}

enum FeeMode {
  FIXED_PER_PLAYER
  EQUAL_SPLIT
}

enum PaymentKind {
  COLLECTION
  REFUND
  WAIVER
  WAIVER_REVERSAL
}

enum PaymentMethod {
  CASH
  EWALLET
  OTHER
}

enum LatePenaltyState {
  PENDING
  SERVED
  WAIVED
}

model QueueMaster {
  id                    String                @id @default(uuid()) @map("_id")
  username              String
  normalizedUsername    String                @unique
  passwordHash          String
  role                  AccountRole           @default(QUEUE_MASTER)
  status                QueueMasterStatus     @default(ACTIVE)
  passwordChangedAt     DateTime              @default(now())
  lastLoginAt           DateTime?
  failedLoginCount      Int                   @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  version               Int                   @default(1)
  settings              QueueMasterSettings?
  workspace             QueueWorkspace?
  players               Player[]
  queuePlayers          QueuePlayer[]
  courts                Court[]
  matches               Match[]
  feeConfig             QueueFeeConfig?
  payments              Payment[]
  authSessions          AuthSession[]
  auditLogs             AuditLog[]
  idempotencyRecords    IdempotencyRecord[]
  syncState             AccountSyncState?
}

// A single database row serializes account mutations that must preserve
// the invariant that at least one active Super Admin remains.
model AccountAdministrationState {
  id        String   @id @default("singleton") @map("_id")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

model QueueMasterSettings {
  id                    String             @id @default(uuid()) @map("_id")
  queueMasterId         String             @unique
  queueMaster            QueueMaster        @relation(fields: [queueMasterId], references: [id])
  pointsToWin           Int                @default(31)
  winBy                 Int                @default(1)
  scoreCap              Int?
  bestOf                Int                @default(1)
  minimumRestMinutes    Int                @default(0)
  defaultFeeMode        FeeMode            @default(FIXED_PER_PLAYER)
  defaultFixedFeeMinor  Int?
  currencyCode          String             @default("PHP")
  timeZone              String             @default("Asia/Manila")
  defaultLateArrivalCutoffTime String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  version               Int                @default(1)
}

model QueueWorkspace {
  queueMasterId          String      @id @map("_id")
  queueMaster            QueueMaster @relation(fields: [queueMasterId], references: [id])
  startedAt              DateTime    @default(now())
  lateArrivalCutoffAt    DateTime?
  matchmakingAlgorithm   String      @default("v2-rotation")
  matchmakingRevision    Int         @default(1)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  version                Int         @default(1)
}

model AccountSyncState {
  id                String      @id @default(uuid()) @map("_id")
  queueMasterId     String      @unique
  queueMaster       QueueMaster @relation(fields: [queueMasterId], references: [id])
  cloudRevision     Int         @default(1)
  lastDeviceId      String?
  lastOperationId   String?
  lastSyncedAt      DateTime?
  schemaVersion     Int         @default(2)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  version           Int         @default(1)
}

model AuthSession {
  id                String       @id @default(uuid()) @map("_id")
  queueMasterId     String
  queueMaster       QueueMaster  @relation(fields: [queueMasterId], references: [id])
  secretHash        String       @unique
  previousHash      String?
  csrfTokenHash     String
  createdAt         DateTime     @default(now())
  lastSeenAt         DateTime     @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  rotatedAt         DateTime?
  revokedAt         DateTime?
  revokeReason      String?
  userAgentHash     String?
  ipPrefixHash      String?
  version           Int          @default(1)

  @@index([queueMasterId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model LoginThrottle {
  id            String   @id @default(uuid()) @map("_id")
  keyHash       String   @unique
  failureCount  Int      @default(0)
  windowStarted DateTime @default(now())
  blockedUntil  DateTime?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([expiresAt])
}

model Player {
  id                 String        @id @default(uuid()) @map("_id")
  queueMasterId      String
  queueMaster        QueueMaster   @relation(fields: [queueMasterId], references: [id])
  displayName        String
  normalizedName     String
  gender             Gender
  skillLevel         SkillLevel
  skillWeight        Int
  status             PlayerStatus   @default(ACTIVE)
  archivedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  version            Int            @default(1)
  queuePlayers       QueuePlayer[]

  @@unique([queueMasterId, normalizedName])
  @@index([queueMasterId, status, normalizedName])
  @@index([queueMasterId, status, gender, skillLevel])
}

model QueuePlayer {
  id                    String             @id @default(uuid()) @map("_id")
  queueMasterId         String
  queueMaster            QueueMaster        @relation(fields: [queueMasterId], references: [id])
  playerId              String
  player                Player             @relation(fields: [playerId], references: [id])
  displayNameSnapshot   String
  normalizedNameSnapshot String
  genderSnapshot        Gender
  skillLevelSnapshot    SkillLevel
  skillWeightSnapshot   Int
  status                QueuePlayerStatus  @default(INACTIVE)
  checkedInAt           DateTime?
  checkedOutAt          DateTime?
  restStartedAt         DateTime?
  queueEnteredAt        DateTime?
  lastMatchEndedAt      DateTime?
  manualPriority        Int                @default(0)
  priorityReason        String?
  latePenaltyState      LatePenaltyState?
  latePenaltyAppliedAt  DateTime?
  currentMatchId        String?
  matchesPlayed         Int                @default(0)
  wins                  Int                @default(0)
  losses                Int                @default(0)
  pointsFor             Int                @default(0)
  pointsAgainst         Int                @default(0)
  amountDueMinor        Int                @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  version               Int                @default(1)
  participants          MatchParticipant[]
  payments              Payment[]

  @@unique([queueMasterId, playerId])
  @@index([queueMasterId, status, queueEnteredAt])
  @@index([queueMasterId, matchesPlayed, queueEnteredAt])
  @@index([currentMatchId])
}

model Court {
  id             String       @id @default(uuid()) @map("_id")
  queueMasterId  String
  queueMaster    QueueMaster  @relation(fields: [queueMasterId], references: [id])
  name           String
  normalizedName String
  displayOrder   Int          @default(0)
  status         CourtStatus  @default(AVAILABLE)
  currentMatchId String?
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  version        Int          @default(1)
  matches        Match[]      @relation("MatchCourt")

  @@unique([queueMasterId, normalizedName])
  @@index([queueMasterId, status, displayOrder])
  @@index([currentMatchId])
}

model Match {
  id                    String              @id @default(uuid()) @map("_id")
  queueMasterId         String
  queueMaster            QueueMaster         @relation(fields: [queueMasterId], references: [id])
  courtId               String?
  court                 Court?              @relation("MatchCourt", fields: [courtId], references: [id])
  courtIdSnapshot       String?
  courtNameSnapshot     String?
  status                MatchStatus         @default(QUEUED)
  source                MatchSource
  matchmakingMode       MatchmakingMode?
  algorithmVersion      String?
  suggestionKey         String?
  suggestionExplanation Json?
  pointsToWin           Int
  winBy                 Int
  scoreCap              Int?
  bestOf                Int
  queuedAt              DateTime            @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  winnerTeam            TeamSide?
  currentRevisionId     String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  version               Int                 @default(1)
  participants          MatchParticipant[]
  scoreRevisions       MatchScoreRevision[] @relation("MatchRevisions")

  @@index([queueMasterId, status, queuedAt])
}

model MatchParticipant {
  id                  String        @id @default(uuid()) @map("_id")
  matchId             String
  match               Match         @relation(fields: [matchId], references: [id])
  queuePlayerId       String
  queuePlayer         QueuePlayer   @relation(fields: [queuePlayerId], references: [id])
  team                TeamSide
  teamSlot            Int
  priorQueueEnteredAt DateTime?
  createdAt           DateTime      @default(now())

  @@unique([matchId, queuePlayerId])
  @@unique([matchId, team, teamSlot])
  @@index([queuePlayerId, matchId])
}

model MatchScoreRevision {
  id                    String              @id @default(uuid()) @map("_id")
  matchId               String
  match                 Match               @relation("MatchRevisions", fields: [matchId], references: [id])
  revisionNumber        Int
  winnerTeam            TeamSide
  reason                String?
  createdByQueueMasterId String
  supersedesRevisionId  String?
  createdAt             DateTime            @default(now())
  games                 MatchGame[]

  @@unique([matchId, revisionNumber])
  @@index([matchId, createdAt])
}

model QueueFeeConfig {
  id                       String       @id @default(uuid()) @map("_id")
  queueMasterId            String       @unique
  queueMaster              QueueMaster  @relation(fields: [queueMasterId], references: [id])
  mode                     FeeMode
  currencyCode             String       @default("PHP")
  fixedAmountPerPlayerMinor Int?
  expectedQueueCostMinor   Int?
  participationRule       String       @default("EVER_CHECKED_IN")
  frozenAt                 DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  version                  Int           @default(1)
}

model MatchGame {
  id             String              @id @default(uuid()) @map("_id")
  scoreRevisionId String
  scoreRevision MatchScoreRevision @relation(fields: [scoreRevisionId], references: [id])
  gameNumber     Int
  teamAScore     Int
  teamBScore     Int
  winnerTeam     TeamSide
  createdAt      DateTime            @default(now())

  @@unique([scoreRevisionId, gameNumber])
}

model Payment {
  id                  String       @id @default(uuid()) @map("_id")
  queueMasterId       String
  queueMaster         QueueMaster  @relation(fields: [queueMasterId], references: [id])
  queuePlayerId       String
  queuePlayer         QueuePlayer  @relation(fields: [queuePlayerId], references: [id])
  kind                PaymentKind
  method              PaymentMethod?
  amountMinor         Int
  reference           String?
  note                String?
  reversalOfPaymentId String?
  reversalOf          Payment?     @relation("PaymentReversal", fields: [reversalOfPaymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversals            Payment[]   @relation("PaymentReversal")
  recordedById         String
  occurredAt           DateTime     @default(now())
  createdAt            DateTime     @default(now())

  @@index([queueMasterId, queuePlayerId, occurredAt])
  @@index([queueMasterId, kind, method])
}

model AuditLog {
  id             String      @id @default(uuid()) @map("_id")
  queueMasterId  String
  queueMaster    QueueMaster @relation(fields: [queueMasterId], references: [id])
  action         String
  entityType     String
  entityId       String
  reason         String?
  beforeJson     Json?
  afterJson      Json?
  requestId      String
  createdAt      DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([queueMasterId, action, createdAt])
}

model IdempotencyRecord {
  id              String      @id @default(uuid()) @map("_id")
  queueMasterId   String
  queueMaster    QueueMaster @relation(fields: [queueMasterId], references: [id])
  operation       String
  key             String
  requestHash     String
  resultType      String
  resultId        String
  responseStatus  Int
  createdAt       DateTime    @default(now())
  expiresAt       DateTime

  @@unique([queueMasterId, operation, key])
  @@index([expiresAt])
}
